# General settings:
APP_PORT=8080
APP_ENVIRONMENT="development"
APP_BASE_URL="http://localhost:8080"

# Cookie settings:
SESSION_SECRET_KEY="secret"
SESSION_EXPIRY_IN_SECONDS=3600
SESSION_USE_COOKIE_STORE=false

# PG Admin
POSTGRES_PASSWORD=super-strong-admin-password

# Store settings:
APP_DB_NAME="cspotlight"
APP_DB_PASSWORD="apppassword"
MIGRATOR_DB_PASSWORD="migratorpassword"
DB_ADDR="host=postgres user=appuser password=apppassword dbname=cspotlight port=5432 sslmode=disable TimeZone=UTC"
MIGRATOR_DB_ADDR="host=postgres user=migrator password=migratorpassword dbname=cspotlight port=5432 sslmode=disable TimeZone=UTC"

# CORS settings:
CORS_ORIGINS="http://localhost:5173"
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="Origin,Content-Type"
CORS_EXPOSE_HEADERS="Content-Length"

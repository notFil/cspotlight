# General settings:
APP_PORT=8080
APP_ENVIRONMENT="development"
APP_BASE_URL="http://localhost:8080"
APP_STATIC_PATH="../static"

# Cookie settings:
SESSION_SECRET_KEY="secret"
SESSION_EXPIRY_IN_SECONDS=3600
SESSION_USE_COOKIE_STORE=false

# Store settings:
DB_ADDR="host=127.0.0.1 user=appuser dbname=cspotlight port=5432 sslmode=disable TimeZone=UTC"

# CORS settings:
CORS_ORIGINS="http://localhost:5173"
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="Origin,Content-Type"
CORS_EXPOSE_HEADERS="Content-Length"


#goose environment variables
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations

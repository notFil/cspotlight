# General settings:
APP_PORT=8080
APP_ENVIRONMENT="development"
APP_BASE_URL="http://localhost:8080"

# Cookie settings:
SESSION_SECRET_KEY="secret"
SESSION_EXPIRY_IN_SECONDS=600
SESSION_USE_COOKIE_STORE=true

# Store settings:
DB_ADDR="host=127.0.0.1 user=appuser dbname=cspotlight port=5432 sslmode=disable TimeZone=UTC"
REDIS_ADDR="localhost:6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_IDLE_CONNS=0

# CORS settings:
CORS_ORIGIN="http://localhost:5173"
CORS_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="Origin,Content-Type"
CORS_EXPOSE_HEADERS="Content-Length"


#goose environment variables
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations
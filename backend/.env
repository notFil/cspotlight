# General settings:
APP_PORT=8080
APP_ENVIRONMENT="development"
APP_BASE_URL="https://localhost:8080"

# JWT settings:
JWT_ACCESS_SECRET_KEY="secret"
JWT_REFRESH_SECRET_KEY="secret"
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRY_MINUTES=300

# Store settings:
DB_ADDR="host=127.0.0.1 user=appuser dbname=cspotlight port=5432 sslmode=disable TimeZone=UTC"
REDIS_ADDR="localhost:6379"

#goose environment variables
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations